<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="9.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="9.0.6" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\BookContext\BookController\" />
    <Folder Include="Controllers\CatalogContext\CatalogController\" />
    <Folder Include="Controllers\BookContext\" />
    <Folder Include="Controllers\CatalogContext\" />
    <Folder Include="Controllers\SwapContext\" />
    <Folder Include="Controllers\SwapContext\SwapController\" />
    <Folder Include="Controllers\UserContext\UserController\" />
  </ItemGroup>

</Project>
